---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import TopBar from '../components/TopBar.jsx';
import Capas from '../components/Capas.jsx';
import Pie from '../components/Pie.astro';

// Marco comun de todas las paginas. Cada pieza carga solo lo que necesita y cuando lo necesita:
//   TopBar  client:load   se usa desde el primer momento (buscar, nota, entrar)
//   <slot>                la vista de cada pagina, con la directiva que le toque
//   Pie                   HTML puro, sin JavaScript
//   Capas   client:idle   avisos y dialogos; se hidratan cuando el navegador queda libre
const { titulo = 'EnCaja Autopartes' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Catálogo de refacciones con compatibilidad vehicular verificada" />
    <meta name="theme-color" content="#F7F7F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D0D0D" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{titulo}</title>
    <!-- Aplica el tema guardado antes de pintar, para que no parpadee. -->
    <script is:inline>
      try {
        const tema = localStorage.getItem('encaja-tema');
        if (tema === 'claro' || tema === 'oscuro') document.documentElement.dataset.tema = tema;
      } catch {}
    </script>
  </head>
  <body>
    <div class="app">
      <TopBar client:load ruta={Astro.url.pathname} />
      <main class="app-main">
        <slot />
      </main>
      <Pie />
      <Capas client:idle />
    </div>
  </body>
</html>
