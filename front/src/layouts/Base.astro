---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { pwaInfo } from 'virtual:pwa-info';
import '../styles/global.css';
import TopBar from '../components/TopBar.jsx';
import Capas from '../components/Capas.jsx';
import Pie from '../components/Pie.astro';
import { IDIOMAS, IDIOMA_BASE, datos, idiomaDeRuta, traducir } from '../i18n';

// Marco comun de todas las paginas. Cada pieza carga solo lo que necesita y cuando lo necesita:
//   TopBar  client:idle   su HTML viene completo del build (enlaces y buscador funcionan sin JS); el menu de
//                         vehiculo y la nota se activan cuando el navegador queda libre
//   <slot>                la vista de cada pagina, con la directiva que le toque
//   Pie                   HTML puro, sin JavaScript
//   Capas   client:idle   avisos y dialogos; se hidratan cuando el navegador queda libre
//
// SEO: cada pagina manda su titulo (<= 60 caracteres) y su descripcion (<= 160). La canonical y Open Graph
// salen de aqui; las paginas privadas (sesion, pedidos, panel) van con noindex.
//
// Idiomas (practica P3-4): el idioma sale de la URL (Astro.currentLocale: /en/... es 'en'). `alternos` trae la
// misma pagina en cada idioma de astro.config.mjs ({ es: '/categoria/frenos/', en: '/en/category/brakes/' }): con
// ella se escriben los hreflang y el selector de idioma apunta ahi. Las paginas que solo existen en el idioma base
// (cuenta, pago, panel) no la mandan.
interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string | null;
  tipo?: 'website' | 'product';
  noindex?: boolean;
  jsonLd?: object | null;
  alternos?: Record<string, string> | null;
}
const idioma = IDIOMAS.includes(Astro.currentLocale ?? '') ? Astro.currentLocale! : idiomaDeRuta(Astro.url.pathname);
const t = (clave: string) => traducir(idioma, clave);
const {
  titulo = 'EnCaja Autopartes',
  descripcion = t('seo.descripcionGeneral'),
  imagen = '/marca/icono-512.png',
  tipo = 'website',
  noindex = false,
  jsonLd = null,
  alternos = null,
} = Astro.props;
// Sin query params: /categoria?q=balatas y /categoria son la misma pagina para un buscador.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imagenAbsoluta = imagen ? new URL(imagen, Astro.site).href : null;
const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: la pagina usa toda la pantalla (notch y esquinas incluidas); el CSS se aparta de las
         zonas del sistema con env(safe-area-inset-*). -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <!-- Versiones por idioma para los buscadores (solo en las paginas indexables que existen en todos los idiomas);
         x-default es la del idioma base. -->
    {alternos && !noindex && Object.entries(alternos).map(([codigo, ruta]) => <link rel="alternate" hreflang={codigo} href={absoluta(ruta)} />)}
    {alternos && !noindex && <link rel="alternate" hreflang="x-default" href={absoluta(alternos[IDIOMA_BASE])} />}
    <meta property="og:site_name" content="EnCaja Autopartes" />
    <meta property="og:locale" content={datos(idioma).idioma.og} />
    {alternos && IDIOMAS.filter((codigo) => codigo !== idioma).map((codigo) => <meta property="og:locale:alternate" content={datos(codigo).idioma.og} />)}
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    <meta name="twitter:card" content={imagenAbsoluta ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- PWA: el manifiesto (nombre, iconos, colores) del idioma base lo genera @vite-pwa/astro en el build (no existe en
         `astro dev`); el de los demas idiomas, src/pages/[...idioma]/manifest.webmanifest.js. -->
    {idioma !== IDIOMA_BASE ? <link rel="manifest" href={`/${idioma}/manifest.webmanifest`} /> : pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <!-- Ya instalada (ventana propia), la barra de titulo va en el rojo de la marca (--rojo, igual que theme_color del
         manifiesto); en el navegador se funde con la barra superior. Gana la primera etiqueta cuyo media coincide. -->
    <meta name="theme-color" content="#E10600" media="(display-mode: standalone)" />
    <meta name="theme-color" content="#F7F7F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D0D0D" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <!-- La fuente del texto (y del titulo grande, que es lo mas grande de la pagina) se pide de inmediato. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Aplica el tema guardado antes de pintar, para que no parpadee. -->
    <script is:inline>
      try {
        const tema = localStorage.getItem('encaja-tema');
        if (tema === 'claro' || tema === 'oscuro') document.documentElement.dataset.tema = tema;
      } catch {}
    </script>
  </head>
  <body>
    <div class="app">
      <TopBar client:idle ruta={Astro.url.pathname} idioma={idioma} alternos={alternos} />
      <!-- Estado de la red y de la app (service worker): sin conexion, version nueva, lista para usarse sin red. -->
      <div class="red-estado" data-red hidden role="status" aria-live="polite">
        <p class="red-estado-texto" data-red-texto></p>
        <button type="button" class="btn btn-chico red-estado-boton" data-red-boton hidden></button>
      </div>
      <main class="app-main">
        <slot />
      </main>
      <Pie idioma={idioma} />
      <Capas client:idle idioma={idioma} />
    </div>
    <script>
      // Registra el service worker (src/sw.js) y avisa en la franja de estado lo que pasa con la red y la app.
      // En `astro dev` el modulo no registra nada (el service worker solo existe en el build).
      import { registerSW } from 'virtual:pwa-register';
      import { useTienda } from '../store/useTienda';
      import { traducir } from '../i18n';
      import { idiomaDelDocumento } from '../i18n';

      // Los avisos van en el idioma de la pagina (lang de <html>).
      const t = (mensaje, variables) => traducir(idiomaDelDocumento(), mensaje, variables);
      const franja = document.querySelector('[data-red]');
      const texto = franja.querySelector('[data-red-texto]');
      const boton = franja.querySelector('[data-red-boton]');
      const SIN_RED = t('red.sinConexion');
      let temporizador;

      // segundos > 0: el aviso se va solo (y si sigue sin red, vuelve el de "sin conexion").
      function mostrar(mensaje, { sinRed = false, accion = null, segundos = 0 } = {}) {
        clearTimeout(temporizador);
        texto.textContent = mensaje;
        franja.classList.toggle('sin-red', sinRed);
        boton.hidden = !accion;
        boton.textContent = accion?.texto ?? '';
        boton.onclick = accion?.alPulsar ?? null;
        franja.hidden = false;
        if (segundos) temporizador = setTimeout(() => (navigator.onLine ? (franja.hidden = true) : mostrar(SIN_RED, { sinRed: true })), segundos * 1000);
      }

      if (!navigator.onLine) mostrar(SIN_RED, { sinRed: true });
      window.addEventListener('offline', () => mostrar(SIN_RED, { sinRed: true }));
      window.addEventListener('online', () => {
        mostrar(t('red.volvioLaRed'), { segundos: 3 });
        // Respaldo de Background Sync: envia lo que se guardo sin red (bitacora).
        navigator.serviceWorker?.controller?.postMessage({ type: 'REINTENTAR_COLA' });
      });

      // Actualizacion limpia: la version nueva espera hasta que el usuario la pide; entonces el service worker
      // hace skipWaiting + clients.claim y, cuando ya controla esta pestana (controllerchange), se recarga una vez.
      let actualizando = false;
      navigator.serviceWorker?.addEventListener('controllerchange', () => {
        if (!actualizando) return;
        actualizando = false;
        location.reload();
      });
      const actualizar = registerSW({
        immediate: true,
        onNeedRefresh() {
          mostrar(t('red.versionNueva'), {
            accion: {
              texto: t('red.actualizar'),
              alPulsar: () => {
                actualizando = true;
                mostrar(t('red.actualizando'));
                actualizar(); // manda SKIP_WAITING al service worker que espera
              },
            },
          });
        },
        onOfflineReady() {
          mostrar(t('red.listoSinConexion'), { segundos: 6 });
        },
      });

      // (bono) El service worker envio los servicios guardados sin red: se refrescan los datos y se avisa.
      navigator.serviceWorker?.addEventListener('message', (evento) => {
        if (evento.data?.type !== 'COLA_ENVIADA') return;
        const { enviados, rechazados } = evento.data;
        useTienda.getState().refrescar();
        mostrar(
          rechazados.length
            ? t('red.servicioRechazado', { motivo: rechazados[0] })
            : enviados === 1
              ? t('red.servicioEnviado')
              : t('red.serviciosEnviados', { n: enviados }),
          { segundos: 6 }
        );
      });
    </script>
  </body>
</html>
