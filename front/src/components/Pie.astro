---
// Pie de pagina: HTML generado en el build. No es una isla de React; solo lleva el script corto del boton de
// instalar la PWA. Textos en el idioma de la pagina.
import { traducir } from '../i18n';

const { idioma = 'es' } = Astro.props;
const t = (texto: string) => traducir(idioma, texto);
---

<footer class="pie">
  <div class="rejilla pie-fila">
    <p class="pie-marca">
      <span class="marca-logo" role="img" aria-label="EnCaja Autopartes"></span>
    </p>
    <p class="pie-texto">{t('pie.lema')}</p>
    <p class="pie-texto">{t('pie.ubicacion')}</p>
    <!-- Oculto hasta que el navegador avisa (beforeinstallprompt) que la tienda se puede instalar. -->
    <div class="pie-instalar" data-instalar hidden>
      <p class="pie-texto">{t('pie.instalarTexto')}</p>
      <button type="button" class="btn btn-secundario btn-chico">{t('pie.instalarApp')}</button>
    </div>
  </div>
</footer>

<!-- is:inline: corre en cuanto se lee el pie, para no perder el evento si Chrome lo lanza pronto. -->
<script is:inline>
  (() => {
    const caja = document.querySelector('[data-instalar]');
    if (!caja) return;
    let aviso = null;
    window.addEventListener('beforeinstallprompt', (evento) => {
      // Sin la mini barra de Chrome: la tienda ofrece su propio boton.
      evento.preventDefault();
      aviso = evento;
      caja.hidden = false;
    });
    caja.querySelector('button').addEventListener('click', async () => {
      if (!aviso) return;
      caja.hidden = true;
      aviso.prompt(); // el dialogo de instalacion del navegador
      await aviso.userChoice; // el evento solo se puede usar una vez, instale o no
      aviso = null;
    });
    window.addEventListener('appinstalled', () => {
      caja.hidden = true;
      aviso = null;
    });
  })();
</script>
