---
// Respaldo para piezas agregadas despues del build: /producto/<slug> llega aqui como /producto?slug= (y lo mismo en
// cada idioma: /en/product?slug=...). Las reglas las escribe redireccionesPorIdioma en astro.config.mjs.
import Base from '../layouts/Base.astro';
import FichaProducto from '../components/FichaProducto.jsx';
import Nota from '../components/Nota.jsx';
import { traducir } from '../i18n';

const { idioma } = Astro.props;
---

<Base titulo={traducir(idioma, 'seo.tituloPieza')} noindex>
  <FichaProducto client:only="react" idioma={idioma} />
  <Nota client:idle idioma={idioma} />
</Base>
