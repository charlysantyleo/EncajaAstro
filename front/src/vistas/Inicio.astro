---
// Pagina de inicio en el idioma que se pida: / (es) y /en/ (en).
import Base from '../layouts/Base.astro';
import HomeView from '../components/HomeView.jsx';
import Nota from '../components/Nota.jsx';
import StockEnVivo from '../components/StockEnVivo.jsx';
import { catalogoDeBuild } from '../lib/datosDeBuild';
import { paraLista } from '../lib/paraLista';
import { traducir } from '../i18n/textos';
import { traducirCategoria, traducirProducto } from '../i18n/catalogo';

interface Props {
  idioma: 'es' | 'en';
}
const { idioma } = Astro.props;
const t = (texto: string) => traducir(idioma, texto);

// El indice de sistemas y las primeras piezas se leen en el build: el HTML ya los trae (sin esqueletos),
// y los enlaces a cada sistema quedan a la vista de un buscador.
const { categorias, productos } = await catalogoDeBuild();
const categoriasDelIdioma = categorias.map((c) => traducirCategoria(c, idioma));
const iniciales = productos.slice(0, 12).map((p) => paraLista(traducirProducto(p, idioma)));
---

<Base
  titulo={t('EnCaja Autopartes | Refacciones con compatibilidad verificada')}
  descripcion={t('Refacciones para tu auto en Guadalajara: balatas, filtros, suspensión y más, con compatibilidad verificada por marca, modelo y año.')}
  alternos={{ es: '/', en: '/en/' }}
>
  <!-- client:idle: el HTML ya trae el titulo, los sistemas y las piezas; React se activa al quedar libre el navegador
       (sus ~150 KB de JavaScript ya no compiten con el primer pintado). -->
  <HomeView client:idle idioma={idioma} categorias={categoriasDelIdioma} productosIniciales={iniciales} />
  <!-- En pantallas anchas la nota se ve a la derecha del catalogo (NotaLateral, dentro de HomeView). -->
  <Nota client:idle idioma={idioma} conLateral />
  <StockEnVivo client:idle />
</Base>
