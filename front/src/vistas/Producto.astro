---
// Pagina de una pieza en cada idioma (/producto/bc-4021-balatas-delanteras-ceramicas/, /en/product/bc-4021-front-ceramic-brake-pads/...),
// generada en el build: el HTML ya trae nombre, foto, precio y compatibilidades, y los datos estructurados
// (JSON-LD Product) para los buscadores. Una pieza agregada despues del build la atiende la pagina de respaldo
// (?slug=, ver redireccionesPorIdioma en astro.config.mjs) hasta el siguiente deploy.
import Base from '../layouts/Base.astro';
import FichaProducto from '../components/FichaProducto.jsx';
import Nota from '../components/Nota.jsx';
import StockEnVivo from '../components/StockEnVivo.jsx';
import { imagenDe } from '../imagenes';
import { describir } from '../lib/compat';
import { alternos, rutaDeCategoria, rutaDeProducto } from '../lib/paginas';
import { rutasPara } from '../lib/rutas';
import { locale, traducir } from '../i18n';
import { traducirProducto } from '../i18n/catalogo';

const { producto: original, idioma } = Astro.props;
const t = (clave: string, variables?: Record<string, unknown>) => traducir(idioma, clave, variables);
const producto = traducirProducto(original, idioma);
const versiones = alternos((i) => rutaDeProducto(original, i));

const url = new URL(Astro.url.pathname, Astro.site).href;
const imagen = imagenDe(producto);
const imagenAbsoluta = imagen ? new URL(imagen, Astro.site).href : null;
// Los precios son en pesos mexicanos en todos los idiomas.
const precio = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(producto.precio);

const titulo = `${producto.nombre} ${producto.marca ?? ''} ${producto.numeroParte}`.replace(/\s+/g, ' ').trim();
const tituloPagina = titulo.length > 46 ? `${titulo.slice(0, 45).trim()}… | EnCaja` : `${titulo} | EnCaja`;
const descripcion = t('seo.descripcionProducto', {
  descripcion: producto.descripcion ?? producto.nombre,
  precio,
  np: producto.numeroParte,
});

// schema.org: el producto con su oferta y la ruta de navegacion. isAccessoryOrSparePartFor lista los vehiculos.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    inLanguage: locale(idioma),
    name: producto.nombre,
    description: producto.descripcion ?? producto.nombre,
    sku: producto.numeroParte,
    mpn: producto.numeroParte,
    ...(producto.marca ? { brand: { '@type': 'Brand', name: producto.marca } } : {}),
    ...(producto.categoria ? { category: producto.categoria.nombre } : {}),
    ...(imagenAbsoluta ? { image: [imagenAbsoluta] } : {}),
    url,
    offers: {
      '@type': 'Offer',
      url,
      priceCurrency: 'MXN',
      price: producto.precio.toFixed(2),
      availability: producto.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      itemCondition: 'https://schema.org/NewCondition',
      seller: { '@type': 'Organization', name: 'EnCaja Autopartes' },
    },
    ...(producto.compatibilidades?.length
      ? { isAccessoryOrSparePartFor: producto.compatibilidades.map((c: any) => ({ '@type': 'Car', name: describir(c) })) }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('comun.inicio'), item: new URL(rutasPara(idioma).home, Astro.site).href },
      ...(original.categoria
        ? [{ '@type': 'ListItem', position: 2, name: producto.categoria.nombre, item: new URL(rutaDeCategoria(original.categoria, idioma), Astro.site).href }]
        : []),
      { '@type': 'ListItem', position: original.categoria ? 3 : 2, name: producto.nombre, item: url },
    ],
  },
];
---

<Base titulo={tituloPagina} descripcion={descripcion.slice(0, 160)} imagen={imagen} tipo="product" jsonLd={jsonLd} alternos={versiones}>
  <!-- client:idle: el HTML ya esta completo; el boton de la nota y las existencias se activan al quedar libre el navegador. -->
  <FichaProducto client:idle idioma={idioma} producto={producto} />
  <Nota client:idle idioma={idioma} />
  <StockEnVivo client:idle />
</Base>
