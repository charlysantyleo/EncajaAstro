---
// Resultados de busqueda (?q=) y URL viejas o sistemas nuevos (?id=, ?slug=): /categoria y /en/search.
// Cambian con cada visitante: no se indexan.
import Base from '../layouts/Base.astro';
import CategoriaView from '../components/CategoriaView.jsx';
import Nota from '../components/Nota.jsx';
import StockEnVivo from '../components/StockEnVivo.jsx';
import { traducir } from '../i18n/textos';

const { idioma } = Astro.props;
const t = (texto: string) => traducir(idioma, texto);
---

<Base
  titulo={t('Buscar refacciones | EnCaja Autopartes')}
  descripcion={t('Busca refacciones por nombre o número de parte en EnCaja Autopartes.')}
  alternos={{ es: '/categoria', en: '/en/search' }}
  noindex
>
  <!-- client:only: el titulo y el filtro salen de la URL, que el build no conoce. -->
  <CategoriaView client:only="react" idioma={idioma} />
  <Nota client:idle idioma={idioma} />
  <StockEnVivo client:idle />
</Base>
