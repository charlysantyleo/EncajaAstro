---
// Resultados de busqueda (?q=) y URL viejas o sistemas nuevos (?id=, ?slug=) en cada idioma: /categoria, /en/search...
// Cambian con cada visitante: no se indexan.
import Base from '../layouts/Base.astro';
import CategoriaView from '../components/CategoriaView.jsx';
import Nota from '../components/Nota.jsx';
import StockEnVivo from '../components/StockEnVivo.jsx';
import { traducir } from '../i18n';
import { alternos } from '../lib/paginas';
import { rutasPara } from '../lib/rutas';

const { idioma } = Astro.props;
const t = (clave: string) => traducir(idioma, clave);
---

<Base
  titulo={t('seo.tituloBusqueda')}
  descripcion={t('seo.descripcionBusqueda')}
  alternos={alternos((i) => rutasPara(i).busqueda('').split('?')[0])}
  noindex
>
  <!-- client:only: el titulo y el filtro salen de la URL, que el build no conoce. -->
  <CategoriaView client:only="react" idioma={idioma} />
  <Nota client:idle idioma={idioma} />
  <StockEnVivo client:idle />
</Base>
