---
import Base from '../layouts/Base.astro';
import CategoriaView from '../components/CategoriaView.jsx';
import Nota from '../components/Nota.jsx';
import StockEnVivo from '../components/StockEnVivo.jsx';
---

<Base titulo="Catalogo | EnCaja Autopartes">
  <!-- client:only: el titulo y el filtro salen de la URL (?id, ?q), que el build no conoce. -->
  <CategoriaView client:only="react" />
  <Nota client:idle />
  <StockEnVivo client:idle />
</Base>
