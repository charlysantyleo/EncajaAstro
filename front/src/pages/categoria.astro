---
import Base from '../layouts/Base.astro';
import CategoriaView from '../components/CategoriaView.jsx';
import Nota from '../components/Nota.jsx';
import StockEnVivo from '../components/StockEnVivo.jsx';
---

<!-- Resultados de busqueda (?q=) y URL viejas (?id=, ?slug=): cambian con cada visitante, no se indexan. -->
<Base titulo="Buscar refacciones | EnCaja Autopartes" descripcion="Busca refacciones por nombre o número de parte en EnCaja Autopartes." noindex>
  <!-- client:only: el titulo y el filtro salen de la URL, que el build no conoce. -->
  <CategoriaView client:only="react" />
  <Nota client:idle />
  <StockEnVivo client:idle />
</Base>
