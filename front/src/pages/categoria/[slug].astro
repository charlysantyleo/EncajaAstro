---
import Base from '../../layouts/Base.astro';
import CategoriaView from '../../components/CategoriaView.jsx';
import Nota from '../../components/Nota.jsx';
import StockEnVivo from '../../components/StockEnVivo.jsx';
import { catalogoDeBuild } from '../../lib/datosDeBuild';
import { paraLista } from '../../lib/paraLista';
import { slugDeCategoria } from '../../lib/slug';

// Una pagina por sistema (/categoria/frenos...), generada en el build con sus piezas: el HTML ya trae el titulo y
// la lista, asi no hay pantalla vacia ni brinco de contenido al cargar. Las existencias y el filtro por vehiculo
// se ponen al dia en el navegador. Un sistema creado despues del build lo atiende /categoria?slug= (public/_redirects).
export async function getStaticPaths() {
  const { categorias, productos } = await catalogoDeBuild();
  return categorias.map((categoria) => ({
    params: { slug: slugDeCategoria(categoria) },
    props: { categoria, categorias, productos: productos.filter((p) => p.categoria?.id === categoria.id) },
  }));
}

const { categoria, categorias, productos } = Astro.props;
const descripcion = `${categoria.nombre}: ${categoria.descripcion ?? 'refacciones'}. ${productos.length} piezas con compatibilidad verificada, envío en Guadalajara.`;
---

<Base titulo={`${categoria.nombre} | Refacciones EnCaja Autopartes`} descripcion={descripcion.slice(0, 160)}>
  <!-- client:idle: el HTML ya trae el titulo y la lista; el filtro por vehiculo y la nota se activan despues. -->
  <CategoriaView client:idle categoria={categoria} categorias={categorias} productosIniciales={productos.map(paraLista)} />
  <Nota client:idle />
  <StockEnVivo client:idle />
</Base>
