PORT=4000
DATABASE_URL=postgresql://:holamundo@host:5432/basededatos?sslmode=require
DATABASE_SSL=false

# Autenticacion
# Genera uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
FRONT_URL=http://localhost:4321
# OAuth2 con Google (opcional): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Cobros (opcional). Sin credenciales, esos metodos salen como "no disponible" y solo queda pagar al recoger.
# Guia completa: ../PAGOS.md
# Mercado Pago: tarjetas, efectivo en tiendas (OXXO) y link de pago.
# https://www.mercadopago.com.mx/developers/panel/app -> Credenciales de prueba
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Clave secreta del webhook (Tus integraciones -> Webhooks). Con ella se comprueba la firma de cada aviso.
MP_WEBHOOK_SECRET=
# PayPal: link de pago. https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (pruebas) o live (cobros reales)
PAYPAL_ENV=sandbox
# URL https por la que internet llega a este servidor (produccion o un tunel como ngrok).
# Mercado Pago manda ahi los avisos de pago: POST <BACK_URL_PUBLICA>/webhooks/mercadopago
BACK_URL_PUBLICA=

# Correo (opcional): enlaces para cambiar la contraseña. Sin claves, el enlace se escribe en la consola del servidor.
# Basta con UN proveedor; si hay claves de los dos se usa Mailjet. El remitente debe estar verificado en el proveedor.
# Mailjet: https://app.mailjet.com -> Account Settings -> API Key Management
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Brevo: https://app.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_NOMBRE=EnCaja Autopartes
